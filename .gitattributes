# Force LF line endings for scripts and source files regardless of the
# committer's local core.autocrlf setting, so shell scripts don't break with
# "bad interpreter" errors on Linux/macOS after a Windows clone/commit.
* text=auto eol=lf

*.sh text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.svg text eol=lf

# Binary-ish or generated files: leave alone
*.gif -text
*.png -text
